<Window x:Class="SplitDeck.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SplitDeck" Width="1320" Height="930" MinWidth="1080" MinHeight="740"
        WindowStartupLocation="CenterScreen" Background="#121613" Foreground="#EDF3E9"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#1B211C"/>
    <SolidColorBrush x:Key="Field" Color="#242B25"/>
    <SolidColorBrush x:Key="Line" Color="#343E34"/>
    <SolidColorBrush x:Key="Muted" Color="#A9B6A3"/>
    <SolidColorBrush x:Key="Accent" Color="#C3F18B"/>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="Button" x:Key="ButtonStyle">
      <Setter Property="Foreground" Value="#EDF3E9"/><Setter Property="Background" Value="#242B25"/>
      <Setter Property="BorderBrush" Value="#465247"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,9"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#C3F18B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource ButtonStyle}"><Setter Property="Background" Value="#C3F18B"/><Setter Property="Foreground" Value="#213315"/><Setter Property="BorderBrush" Value="#C3F18B"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#242B25"/><Setter Property="Foreground" Value="#EDF3E9"/><Setter Property="BorderBrush" Value="#465247"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#242B25"/><Setter Property="Foreground" Value="#EDF3E9"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3E5737"/></Trigger></Style.Triggers></Style>
    <Style TargetType="ComboBox"><Setter Property="Background" Value="#242B25"/><Setter Property="Foreground" Value="#EDF3E9"/><Setter Property="BorderBrush" Value="#465247"/><Setter Property="MinHeight" Value="33"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="30"/></Grid.ColumnDefinitions><ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><TextBlock Grid.Column="1" Text="⌄" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </Border>
        <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template></ToggleButton>
        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide"><Border Background="#242B25" BorderBrush="#465247" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
      </Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="BorderBrush" Value="#C3F18B"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Slider"><Setter Property="Foreground" Value="#C3F18B"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EDF3E9"/></Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="86"/><RowDefinition Height="*"/><RowDefinition Height="72"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
      <DockPanel Margin="25,0" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
          <Grid Width="28" Height="25" Margin="0,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="4"/><ColumnDefinition Width="8"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#C3F18B" CornerRadius="3"/><Border Grid.Column="2" Background="#EDF3E9" CornerRadius="3"/></Grid>
          <TextBlock Text="SplitDeck - EXPERIMENTAL v0.2.4" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock Text="LOCAL DISPLAY EDITOR" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="24,3,0,0" VerticalAlignment="Center"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1" Margin="26,17,26,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="A workspace that fits you." FontSize="25" FontWeight="Medium"/><TextBlock x:Name="CountDescription" Text="Two virtual displays. One physical monitor." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="PHYSICAL DISPLAY" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="MonitorPicker" SelectionChanged="MonitorPicker_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FriendlyName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
    </Grid>
    <Grid Grid.Row="2" Margin="26,0,26,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions>
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,18,0">
        <StackPanel>
          <Grid Margin="0,4,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Display layout" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="MonitorMeta" Grid.Column="1" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" Margin="14,2,0,0"/></Grid>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,10"><Button x:Name="TwoScreensButton" Content="2 screens" Click="TwoScreensButton_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="ThreeScreensButton" Content="3 screens" Click="ThreeScreensButton_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/><Button x:Name="TripleButton" Content="Portrait + center + portrait" Click="TripleButton_Click" Style="{StaticResource ButtonStyle}"/></StackPanel>
          <WrapPanel Margin="0,0,0,14">
            <Button x:Name="EqualButton" Content="Equal split" Click="EqualButton_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/>
            <Button x:Name="GameButton" Content="Game + Discord" Click="GameButton_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/>
            <Button x:Name="PortraitButton" Content="Game + portrait" Click="PortraitButton_Click" Style="{StaticResource ButtonStyle}" Margin="0,0,8,0"/>
            <Button Content="Reverse order" Click="SwapButton_Click" Style="{StaticResource ButtonStyle}"/>
          </WrapPanel>
          <TextBlock x:Name="DividerHint" Visibility="Collapsed" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,0,0,10"/>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="Estimated layout demand" FontWeight="SemiBold" Margin="0,0,0,9"/>
              <DockPanel><TextBlock Text="GPU workload"/><TextBlock x:Name="DemandGpuValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
              <ProgressBar x:Name="DemandGpuBar" Minimum="0" Maximum="100" Height="7" Margin="0,5,0,10" Foreground="#C3F18B" Background="#242B25" BorderThickness="0"/>
              <DockPanel ToolTip="Approximate screen-buffer storage, usually VRAM: two BGRA buffers per source and two output buffers. Excludes app RAM, game assets, driver/DWM allocations and CPU fallback buffers. Refresh alone does not change buffer memory."><TextBlock Text="Frame-buffer memory"/><TextBlock x:Name="DemandMemoryValue" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></DockPanel>
              <ProgressBar x:Name="DemandMemoryBar" Minimum="0" Maximum="100" Height="7" Margin="0,5,0,8" Foreground="#9CBCE8" Background="#242B25" BorderThickness="0"/>
              <TextBlock x:Name="DemandNote" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="11"/>
              <TextBlock TextWrapping="Wrap" Text="Memory covers estimated screen buffers, usually VRAM; app RAM and driver allocations are extra. Lower Hz reduces workload, not buffer sizes." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="#0D110E" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20" Height="320">
            <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Viewbox Stretch="Uniform"><Canvas x:Name="PreviewCanvas" Width="720" Height="260" Background="#101810" ClipToBounds="True">
                <Border x:Name="PreviewOne" Background="#293B27" BorderBrush="#C3F18B" BorderThickness="2" CornerRadius="4" MouseLeftButtonDown="PreviewOne_Click"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="1" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewOneName" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewOneDims" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border x:Name="PreviewTwo" Background="#2C303B" BorderBrush="#55615A" BorderThickness="2" CornerRadius="4" MouseLeftButtonDown="PreviewTwo_Click"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="2" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewTwoName" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewTwoDims" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Border x:Name="PreviewThree" Background="#3B3035" BorderBrush="#55615A" BorderThickness="2" CornerRadius="4" MouseLeftButtonDown="PreviewThree_Click" Visibility="Collapsed"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="3" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewThreeName" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock x:Name="PreviewThreeDims" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/></StackPanel></Border>
                <Thumb x:Name="LeftDivider" Visibility="Collapsed" Width="16" Cursor="SizeWE" Focusable="True" Panel.ZIndex="100" DragStarted="Divider_Started" DragDelta="Divider_Delta" DragCompleted="Divider_Completed" KeyDown="Divider_KeyDown">
                  <Thumb.Template><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border Width="2" Background="#C3F18B"/><Border Width="14" Height="36" CornerRadius="5" Background="#C3F18B" VerticalAlignment="Center"><TextBlock Text="⋮" FontSize="22" Foreground="#213315" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></Grid></ControlTemplate></Thumb.Template>
                </Thumb>
                <Thumb x:Name="RightDivider" Visibility="Collapsed" Width="16" Cursor="SizeWE" Focusable="True" Panel.ZIndex="100" DragStarted="Divider_Started" DragDelta="Divider_Delta" DragCompleted="Divider_Completed" KeyDown="Divider_KeyDown" Template="{Binding Template,ElementName=LeftDivider}"/>
              </Canvas></Viewbox>
              <DockPanel Grid.Row="1" Margin="0,9,0,0"><TextBlock x:Name="SizeLabel" Foreground="{StaticResource Muted}"/><TextBlock Text="Shaded area = unused physical pixels" Foreground="{StaticResource Muted}" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel>
            </Grid>
          </Border>
          <Border x:Name="TwoSharePanel" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,14,0,14">
            <StackPanel><DockPanel><TextBlock Text="Space for Screen 1" FontWeight="SemiBold"/><TextBlock x:Name="ShareLabel" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></DockPanel><Slider x:Name="ShareSlider" Minimum="15" Maximum="85" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,11,0,2" ValueChanged="ShareSlider_ValueChanged"/><DockPanel><TextBlock Text="More room for Screen 2" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock Text="More room for Screen 1" Foreground="{StaticResource Muted}" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right"/></DockPanel></StackPanel>
          </Border>
          <Border x:Name="ThreeSharePanel" Visibility="Collapsed" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,14,0,14"><StackPanel><TextBlock Text="Automatic column shares (%)" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Margin="0,9,0,0"><TextBox x:Name="FirstShareInput" Width="65" LostFocus="ThreeShares_LostFocus" ToolTip="Screen 1 percent"/><TextBlock Text=" / " VerticalAlignment="Center"/><TextBox x:Name="SecondShareInput" Width="65" LostFocus="ThreeShares_LostFocus" ToolTip="Screen 2 percent"/><TextBlock x:Name="ThirdShareLabel" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel><TextBlock Text="Exact visible widths reserve their pixels first; automatic columns share the remaining space." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,7,0,0"/></StackPanel></Border>
          <UniformGrid x:Name="SummariesGrid" Columns="2">
            <Button x:Name="SummaryOne" Grid.Column="0" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Click="SummaryOne_Click"><StackPanel><TextBlock x:Name="SummaryOneName" FontWeight="SemiBold"/><TextBlock x:Name="SummaryOnePhysical" FontSize="24" Margin="0,12,0,0"/><TextBlock Text="Visible pixels on your monitor" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="SummaryOneRender" Margin="0,12,0,0"/><TextBlock x:Name="SummaryOneHz" Foreground="{StaticResource Muted}"/></StackPanel></Button>
            <Button x:Name="SummaryTwo" Grid.Column="2" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Click="SummaryTwo_Click"><StackPanel><TextBlock x:Name="SummaryTwoName" FontWeight="SemiBold"/><TextBlock x:Name="SummaryTwoPhysical" FontSize="24" Margin="0,12,0,0"/><TextBlock Text="Visible pixels on your monitor" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="SummaryTwoRender" Margin="0,12,0,0"/><TextBlock x:Name="SummaryTwoHz" Foreground="{StaticResource Muted}"/></StackPanel></Button>
            <Button x:Name="SummaryThree" Style="{StaticResource ButtonStyle}" HorizontalContentAlignment="Stretch" Click="SummaryThree_Click" Visibility="Collapsed"><StackPanel><TextBlock x:Name="SummaryThreeName" FontWeight="SemiBold"/><TextBlock x:Name="SummaryThreePhysical" FontSize="24" Margin="0,12,0,0"/><TextBlock Text="Visible pixels on your monitor" Foreground="{StaticResource Muted}" FontSize="11"/><TextBlock x:Name="SummaryThreeRender" Margin="0,12,0,0"/><TextBlock x:Name="SummaryThreeHz" Foreground="{StaticResource Muted}"/></StackPanel></Button>
          </UniformGrid>
          <TextBlock x:Name="FitNote" Foreground="{StaticResource Muted}" Margin="2,14,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="20,18">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
          <TextBlock Text="Screen settings" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
          <UniformGrid x:Name="EditTabs" Columns="2" Margin="0,0,0,10"><Button x:Name="EditOne" Content="Screen 1" Style="{StaticResource ButtonStyle}" Click="EditOne_Click"/><Button x:Name="EditTwo" Content="Screen 2" Style="{StaticResource ButtonStyle}" Click="EditTwo_Click"/><Button x:Name="EditThree" Content="Screen 3" Style="{StaticResource ButtonStyle}" Click="EditThree_Click" Visibility="Collapsed"/></UniformGrid>
          <UniformGrid Columns="2" Margin="0,0,0,10"><Button x:Name="MoveLeftButton" Content="← Move left" Click="MoveLeftButton_Click" Style="{StaticResource ButtonStyle}"/><Button x:Name="MoveRightButton" Content="Move right →" Click="MoveRightButton_Click" Style="{StaticResource ButtonStyle}"/></UniformGrid>
          <Button x:Name="MakePrimaryButton" Content="Make this the primary screen" Click="MakePrimaryButton_Click" Style="{StaticResource ButtonStyle}"/><TextBlock x:Name="PrimaryNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,15"/>
          <TextBlock Text="NAME" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBox x:Name="NameInput" MaxLength="24" LostFocus="NameInput_LostFocus" Margin="0,6,0,16"/>
          <TextBlock Text="ORIENTATION" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <Grid Margin="0,0,0,17"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="LandscapeButton" Content="▭  Landscape" Grid.Column="0" Style="{StaticResource ButtonStyle}" Click="LandscapeButton_Click"/><Button x:Name="PortraitOrientationButton" Content="▯  Portrait" Grid.Column="2" Style="{StaticResource ButtonStyle}" Click="PortraitOrientationButton_Click"/></Grid>
          <TextBlock Text="ASPECT RATIO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><ComboBox x:Name="RatioPicker" SelectionChanged="RatioPicker_SelectionChanged" Margin="0,6,0,7"><ComboBoxItem Tag="16:9" Content="16:9 · Widescreen"/><ComboBoxItem Tag="16:10" Content="16:10 · Workspace"/><ComboBoxItem Tag="21:9" Content="21:9 · Ultrawide"/><ComboBoxItem Tag="Fill" Content="Fill allotted area"/><ComboBoxItem Tag="Custom" Content="Custom ratio"/></ComboBox>
          <StackPanel x:Name="CustomRatioPanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,0,7"><TextBox x:Name="RatioWidthInput" Width="55" LostFocus="CustomRatio_LostFocus" ToolTip="Aspect width, 1 to 16384"/><TextBlock Text=" : " VerticalAlignment="Center" FontSize="17"/><TextBox x:Name="RatioHeightInput" Width="55" LostFocus="CustomRatio_LostFocus" ToolTip="Aspect height, 1 to 16384"/></StackPanel>
          <TextBlock x:Name="RatioNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,16"/>
          <TextBlock Text="EXACT VISIBLE PIXELS · 0 = AUTO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><Grid Margin="0,6,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="VisibleWidthInput" LostFocus="ExactDimensions_LostFocus" ToolTip="Visible width in physical pixels; 0 automatic"/><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="VisibleHeightInput" Grid.Column="2" LostFocus="ExactDimensions_LostFocus" ToolTip="Visible height in physical pixels; 0 automatic"/></Grid><TextBlock Text="Ratio lock must match exact dimensions. One dimension can be derived from the other." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,15"/>
          <TextBlock Text="RENDER DETAIL" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><ComboBox x:Name="RenderPicker" SelectionChanged="RenderPicker_SelectionChanged" Margin="0,6,0,7"><ComboBoxItem Tag="0" Content="Match visible pixels"/><ComboBoxItem Tag="Exact" Content="Exact dimensions below"/><ComboBoxItem Tag="1080" Content="1080p detail"/><ComboBoxItem Tag="1440" Content="1440p detail"/><ComboBoxItem Tag="2160" Content="2160p / 4K detail"/></ComboBox><TextBlock x:Name="RenderNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,16"/>
          <TextBlock Text="EXACT RENDER PIXELS · 0 = AUTO" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><Grid Margin="0,6,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBox x:Name="RenderWidthInput" LostFocus="ExactDimensions_LostFocus" ToolTip="Virtual render width; 0 automatic"/><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="RenderHeightInput" Grid.Column="2" LostFocus="ExactDimensions_LostFocus" ToolTip="Virtual render height; 0 automatic"/></Grid>
          <TextBlock Text="REFRESH TARGET" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><ComboBox x:Name="RefreshPicker" SelectionChanged="RefreshPicker_SelectionChanged" Margin="0,6,0,7"/><TextBlock x:Name="RefreshNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,17"/>
          <StackPanel Orientation="Horizontal" Margin="0,0,0,16"><TextBox x:Name="ExactRefreshInput" Width="95" LostFocus="ExactRefresh_LostFocus" ToolTip="Exact whole-number refresh target"/><TextBlock Text=" Hz exact target" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/></StackPanel>
          <Border Background="#242B25" CornerRadius="8" Padding="12" Margin="0,0,0,15"><StackPanel><CheckBox x:Name="PriorityToggle" Content="Prioritize Screen 1" FontWeight="SemiBold" Click="PriorityToggle_Click"/><TextBlock x:Name="PriorityNote" Text="Preset: 70% space and highest panel refresh target for Screen 1; 30 Hz target for Screen 2. Both remain editable." Foreground="{StaticResource Muted}" FontSize="11" Margin="20,6,0,0"/></StackPanel></Border>
          <TextBlock x:Name="PanelNote" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,16"/>
          <TextBlock Text="DISPLAY SIZE OVERRIDE (INCHES)" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold"/><TextBox x:Name="SizeInput" LostFocus="SizeInput_LostFocus" Margin="0,6,0,5" ToolTip="Optional cosmetic diagonal size, 10 to 100 inches"/><TextBlock Text="Optional; preview geometry uses pixels." Foreground="{StaticResource Muted}" FontSize="11"/>
          <TextBlock x:Name="ErrorText" Foreground="#F4AA9F" FontSize="11" Margin="0,15,0,0"/>
        </StackPanel></ScrollViewer>
      </Border>
    </Grid>
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="26,12"><DockPanel LastChildFill="True">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="SetupButton" Content="Setup driver" Style="{StaticResource ButtonStyle}" Click="SetupButton_Click" Margin="0,0,8,0"/><Button x:Name="RestoreButton" Content="Restore desktop" Style="{StaticResource ButtonStyle}" Click="RestoreButton_Click" Margin="0,0,8,0" IsEnabled="False"/><Button x:Name="ApplyButton" Content="Apply layout  →" Style="{StaticResource AccentButton}" Click="ApplyButton_Click"/></StackPanel>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Detecting physical displays…" FontWeight="SemiBold"/><TextBlock x:Name="StatusDetail" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,15,0" Text="Editing is local until Apply."/></StackPanel>
    </DockPanel></Border>
  </Grid>
</Window>
